#!/usr/bin/env bash
# Orb environment setup: install tools required by the validation checklist.
# - shellcheck: used by scripts/lint-shell.sh and scripts/lint-shell-all.sh
# - zsh: used by scripts/test-npm-run-local-completion.sh

set -euo pipefail

packages=()

command -v shellcheck >/dev/null 2>&1 || packages+=(shellcheck)
command -v zsh >/dev/null 2>&1 || packages+=(zsh)

if [ "${#packages[@]}" -gt 0 ]; then
  echo "Installing shell test dependencies: ${packages[*]}"
  apt-get update
  apt-get install -y "${packages[@]}"
else
  echo "Shell test dependencies are already installed"
fi
